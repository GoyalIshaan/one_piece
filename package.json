{
	"name": "one-piece",
	"private": true,
	"type": "module",
	"description": "Open-source harness for recursive agent swarms doing scientific discovery",
	"license": "MIT",
	"workspaces": [
		"vendor/pi/packages/telemetry",
		"vendor/pi/packages/schema",
		"vendor/pi/packages/ai",
		"vendor/pi/packages/agent",
		"packages/*"
	],
	"scripts": {
		"build:pi": "cd -P vendor/pi/packages/telemetry && npm run build && cd ../schema && npm run build && cd ../ai && npm run build && cd ../agent && npm run build",
		"test": "vitest --run",
		"typecheck": "tsc -p packages/tsconfig.json && node tools/typecheck-dashboard.mjs",
		"verify:harness": "node packages/eval-lab/src/cli.ts verify",
		"eval:observatory": "node packages/eval-lab/src/cli.ts observatory",
		"eval:index": "node packages/eval-lab/src/cli.ts index",
		"eval:diagnose": "node packages/eval-lab/src/cli.ts diagnose",
		"one-piece": "node packages/cli/src/index.ts"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"devDependencies": {
		"@types/node": "22.19.19",
		"esbuild": "0.28.2",
		"typescript": "7.0.2",
		"vitest": "4.1.12"
	},
	"overrides": {
		"protobufjs": "7.6.6"
	}
}

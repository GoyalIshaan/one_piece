{
	"compilerOptions": {
		"target": "ES2024",
		"module": "Node16",
		"moduleResolution": "Node16",
		"lib": ["ES2024", "DOM"],
		"strict": true,
		"erasableSyntaxOnly": true,
		"verbatimModuleSyntax": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"resolveJsonModule": true,
		"allowImportingTsExtensions": true,
		"noEmit": true,
		"types": ["node"]
	},
	"include": ["*/src/**/*.ts", "*/test/**/*.ts", "evals/tasks/*/verification/**/*.ts"]
}
